+
+type recordedWireGuardSend struct {
+	addr string
+	data []byte
+}
+
+type recordingPacketListener struct {
+	mu    sync.Mutex
+	sends []recordedWireGuardSend
+}
+
+func (r *recordingPacketListener) ListenPacket(ctx context.Context, network, address string) (net.PacketConn, error) {
+	pc, err := (localhostListener{}).ListenPacket(ctx, network, address)
+	if err != nil {
+		return nil, err
+	}
+	return &recordingPacketConn{PacketConn: pc, recorder: r}, nil
+}
+
+type recordingPacketConn struct {
+	net.PacketConn
+	recorder *recordingPacketListener
+}
+
+func (pc *recordingPacketConn) ReadFromUDPAddrPort(data []byte) (int, netip.AddrPort, error) {
+	return pc.PacketConn.(nettype.PacketConn).ReadFromUDPAddrPort(data)
+}
+
+func (pc *recordingPacketConn) WriteToUDPAddrPort(data []byte, addr netip.AddrPort) (int, error) {
+	pc.recorder.mu.Lock()
+	pc.recorder.sends = append(pc.recorder.sends, recordedWireGuardSend{addr: addr.String(), data: append([]byte(nil), data...)})
+	pc.recorder.mu.Unlock()
+	return len(data), nil
+}
+
+func (pc *recordingPacketConn) WriteTo(data []byte, addr net.Addr) (int, error) {
+	pc.recorder.mu.Lock()
+	pc.recorder.sends = append(pc.recorder.sends, recordedWireGuardSend{addr: addr.String(), data: append([]byte(nil), data...)})
+	pc.recorder.mu.Unlock()
+	return len(data), nil
+}
+
+func (r *recordingPacketListener) count() int {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return len(r.sends)
+}
+
+func directOnlyTestConn(t *testing.T, directOnly bool) (*Conn, *recordingPacketListener) {
+	t.Helper()
+	bus := eventbus.New()
+	mon, err := netmon.New(bus, t.Logf)
+	if err != nil {
+		t.Fatal(err)
+	}
+	listener := new(recordingPacketListener)
+	c, err := NewConn(Options{
+		DirectOnlyData:         directOnly,
+		DisablePortMapper:      true,
+		Logf:                   t.Logf,
+		NetMon:                 mon,
+		EventBus:               bus,
+		Metrics:                new(usermetric.Registry),
+		TestOnlyPacketListener: nettype.PacketListener(listener),
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		c.mu.Lock()
+		c.activeDerp = nil // the test DERP channel has no client to close
+		c.mu.Unlock()
+		c.Close()
+		mon.Close()
+		bus.Close()
+	})
+	return c, listener
+}
+
+func directOnlyTestEndpoint(c *Conn, best epAddr, derp bool, trusted bool) (*endpoint, chan derpWriteRequest) {
+	nodeKey := key.NewNode().Public()
+	ep := &endpoint{c: c, publicKey: nodeKey, bestAddr: addrQuality{epAddr: best}, heartbeatDisabled: true}
+	if trusted {
+		ep.trustBestAddrUntil = mono.Now().Add(time.Hour)
+	}
+	if !derp {
+		return ep, nil
+	}
+	ep.derpAddr = netip.AddrPortFrom(tailcfg.DerpMagicIPAddr, 1)
+	ch := make(chan derpWriteRequest, 10)
+	now := time.Now()
+	c.mu.Lock()
+	c.derpMap = &tailcfg.DERPMap{Regions: map[int]*tailcfg.DERPRegion{1: {RegionID: 1}}}
+	c.privateKey = key.NewNode()
+	c.activeDerp = map[int]activeDerp{1: {writeCh: ch, lastWrite: &now}}
+	c.mu.Unlock()
+	return ep, ch
+}
+
+func directOnlyPacket() [][]byte {
+	return [][]byte{{0, 0, 0, 0, 0, 0, 0, 0, 4, 5, 6}}
+}
+
+func TestDirectOnlyDataOutbound(t *testing.T) {
+	direct := epAddr{ap: netip.MustParseAddrPort("127.0.0.1:12345")}
+	relay := epAddr{ap: netip.MustParseAddrPort("127.0.0.1:12346")}
+	relay.vni.Set(7)
+	tests := []struct {
+		name       string
+		directOnly bool
+		best       epAddr
+		derp       bool
+		trusted    bool
+		wantUDP    int
+		wantDERP   int
+		wantError  bool
+	}{
+		{"default DERP", false, epAddr{}, true, false, 0, 1, false},
+		{"direct", true, direct, false, true, 1, 0, false},
+		{"direct and configured DERP", true, direct, true, true, 1, 0, false},
+		{"untrusted direct and DERP", true, direct, true, false, 0, 0, true},
+		{"default simultaneous direct and DERP", false, direct, true, false, 1, 1, false},
+		{"default peer relay", false, relay, false, true, 1, 0, false},
+		{"DERP only", true, epAddr{}, true, false, 0, 0, true},
+		{"peer relay only", true, relay, false, true, 0, 0, true},
+		{"peer relay and DERP", true, relay, true, false, 0, 0, true},
+		{"no route", true, epAddr{}, false, false, 0, 0, true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			c, udp := directOnlyTestConn(t, tt.directOnly)
+			ep, derp := directOnlyTestEndpoint(c, tt.best, tt.derp, tt.trusted)
+			err := c.Send(directOnlyPacket(), ep, 8)
+			if tt.wantError && !errors.Is(err, errNoDirectPath) {
+				t.Fatalf("error = %v; want no direct path", err)
+			}
+			if !tt.wantError && err != nil {
+				t.Fatal(err)
+			}
+			if got := udp.count(); got != tt.wantUDP {
+				t.Errorf("actual UDP writes = %d; want %d", got, tt.wantUDP)
+			}
+			if got := len(derp); got != tt.wantDERP {
+				t.Errorf("actual DERP queue writes = %d; want %d", got, tt.wantDERP)
+			}
+		})
+	}
+}
+
+func TestDirectOnlyDataPathLossAndFallback(t *testing.T) {
+	c, udp := directOnlyTestConn(t, true)
+	direct := epAddr{ap: netip.MustParseAddrPort("127.0.0.1:12345")}
+	ep, derp := directOnlyTestEndpoint(c, direct, true, true)
+	if err := c.Send(directOnlyPacket(), ep, 8); err != nil {
+		t.Fatal(err)
+	}
+	ep.mu.Lock()
+	ep.trustBestAddrUntil = 0
+	ep.mu.Unlock()
+	if err := c.Send(directOnlyPacket(), ep, 8); !errors.Is(err, errNoDirectPath) {
+		t.Fatalf("expired path error = %v", err)
+	}
+	if udp.count() != 1 || len(derp) != 0 {
+		t.Fatalf("path loss sent UDP=%d DERP=%d", udp.count(), len(derp))
+	}
+
+	ep.mu.Lock()
+	ep.bestAddr = addrQuality{}
+	ep.derpAddr = netip.AddrPort{}
+	ep.mu.Unlock()
+	c.mu.Lock()
+	c.derpRoute = map[key.NodePublic]derpRoute{ep.publicKey: {regionID: 1}}
+	c.mu.Unlock()
+	if err := c.Send(directOnlyPacket(), ep, 8); !errors.Is(err, errNoDirectPath) {
+		t.Fatalf("fallback DERP error = %v", err)
+	}
+	if len(derp) != 0 {
+		t.Fatal("fallback DERP transmitted WireGuard data")
+	}
+}
+
+func TestDirectOnlyDataLowerSendGuards(t *testing.T) {
+	c, udp := directOnlyTestConn(t, true)
+	_, derp := directOnlyTestEndpoint(c, epAddr{}, true, false)
+	peer := key.NewNode().Public()
+	derpAddr := netip.AddrPortFrom(tailcfg.DerpMagicIPAddr, 1)
+	if ok, err := c.sendAddr(derpAddr, peer, []byte{1}, false, false); ok || !errors.Is(err, errNoDirectPath) {
+		t.Fatalf("direct DERP data call = (%v, %v)", ok, err)
+	}
+	relay := epAddr{ap: netip.MustParseAddrPort("127.0.0.1:12346")}
+	relay.vni.Set(7)
+	if ok, err := c.sendUDPBatch(relay, directOnlyPacket(), 8); ok || !errors.Is(err, errNoDirectPath) {
+		t.Fatalf("direct peer-relay data call = (%v, %v)", ok, err)
+	}
+	if len(derp) != 0 || udp.count() != 0 {
+		t.Fatal("lower-level bypass transmitted relay data")
+	}
+}
+
+func TestDirectOnlyDataCookieAndInbound(t *testing.T) {
+	c, udp := directOnlyTestConn(t, true)
+	relay := epAddr{ap: netip.MustParseAddrPort("127.0.0.1:12346")}
+	relay.vni.Set(7)
+	for _, src := range []epAddr{relay, {ap: netip.AddrPortFrom(tailcfg.DerpMagicIPAddr, 1)}} {
+		if err := c.Send(directOnlyPacket(), &lazyEndpoint{src: src}, 8); !errors.Is(err, errNoDirectPath) {
+			t.Fatalf("cookie via relay error = %v", err)
+		}
+	}
+	if udp.count() != 0 {
+		t.Fatal("cookie reply bypassed relay guard")
+	}
+	if err := c.Send(directOnlyPacket(), &lazyEndpoint{src: epAddr{ap: netip.MustParseAddrPort("127.0.0.1:12345")}}, 8); err != nil {
+		t.Fatalf("direct cookie reply: %v", err)
+	}
+	if udp.count() != 1 {
+		t.Fatal("direct cookie reply did not use UDP")
+	}
+
+	c.havePrivateKey.Store(true)
+	geneve := make([]byte, packet.GeneveFixedHeaderLength+3)
+	header := packet.GeneveHeader{Protocol: packet.GeneveProtocolWireGuard, VNI: relay.vni}
+	if err := header.Encode(geneve); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, _, ok := c.receiveIP(geneve, relay.ap, &epAddrEndpointCache{}); ok {
+		t.Fatal("inbound peer relay data accepted")
+	}
+	peer := key.NewNode().Public()
+	dm := derpReadResult{regionID: 1, n: 3, src: peer, copyBuf: func(b []byte) int { return copy(b, []byte{4, 5, 6}) }}
+	if n, ep := c.processDERPReadResult(dm, make([]byte, 16)); n != 0 || ep != nil {
+		t.Fatal("inbound DERP data accepted")
+	}
+	defaultConn, _ := directOnlyTestConn(t, false)
+	defaultConn.havePrivateKey.Store(true)
+	if _, _, _, ok := defaultConn.receiveIP(geneve, relay.ap, &epAddrEndpointCache{}); !ok {
+		t.Fatal("default mode unexpectedly rejected inbound peer relay")
+	}
+	defaultEP := &endpoint{c: defaultConn, nodeID: 1, publicKey: peer, isWireguardOnly: true, heartbeatDisabled: true}
+	defaultConn.mu.Lock()
+	defaultConn.peerMap.upsertEndpoint(defaultEP, key.DiscoPublic{})
+	defaultConn.mu.Unlock()
+	dm.copyBuf = func(b []byte) int { return copy(b, []byte{4, 5, 6}) }
+	if n, ep := defaultConn.processDERPReadResult(dm, make([]byte, 16)); n != 3 || ep != defaultEP {
+		t.Fatalf("default inbound DERP result = (%d, %p), want (3, %p)", n, ep, defaultEP)
+	}
+}
+
+func TestDirectOnlyDataDiscoViaDERP(t *testing.T) {
+	c, udp := directOnlyTestConn(t, true)
+	ep, derp := directOnlyTestEndpoint(c, epAddr{}, true, false)
+	ep.nodeID = 1
+	discoKey := key.NewDisco().Public()
+	ep.disco.Store(&endpointDisco{key: discoKey, short: discoKey.ShortString()})
+	c.mu.Lock()
+	c.peerMap.upsertEndpoint(ep, key.DiscoPublic{})
+	c.mu.Unlock()
+	addr := netip.AddrPortFrom(tailcfg.DerpMagicIPAddr, 1)
+	if ok, err := c.sendDiscoMessage(epAddr{ap: addr}, ep.publicKey, discoKey, &disco.Ping{}, discoVerboseLog); !ok || err != nil {
+		t.Fatalf("disco send = %v, %v", ok, err)
+	}
+	if len(derp) != 1 || !(<-derp).isDisco {
+		t.Fatal("DERP disco was not queued as discovery")
+	}
+	peerRelay := epAddr{ap: netip.MustParseAddrPort("127.0.0.1:12346")}
+	peerRelay.vni.Set(7)
+	if ok, err := c.sendDiscoMessage(peerRelay, ep.publicKey, discoKey, &disco.Ping{}, discoVerboseLog); !ok || err != nil {
+		t.Fatalf("peer relay discovery = %v, %v", ok, err)
+	}
+	if udp.count() != 1 {
+		t.Fatal("peer relay discovery did not reach UDP send path")
+	}
+}
