+	if first.s.DirectOnlyData || second.s.DirectOnlyData {
+		t.Fatal("default must be disabled")
+	}
+	if !first.setDirectOnlyData(true) || !first.s.DirectOnlyData || second.s.DirectOnlyData {
+		t.Fatal("configuration must be per server")
+	}
+	first.freezeConfig()
+	if first.setDirectOnlyData(false) || !first.s.DirectOnlyData {
+		t.Fatal("late setter must reject without mutating the server")
+	}
+	if !second.setDirectOnlyData(false) || second.s.DirectOnlyData {
+		t.Fatal("other server must remain configurable")
+	}
